{
  "name": "growthOS-channel-service",
  "version": "1.0.0",
  "description": "Simulated channel provider for WhatsApp, Email, and SMS",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "npx esbuild src/server.ts --bundle --platform=node --target=node22 --alias:@opentelemetry/api=./node_modules/@opentelemetry/api/build/src/index.js --outfile=dist/server.js"
  },
  "type": "commonjs",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "resend": "^6.34.1",
    "twilio": "^6.2.0",
    "uuid": "^11.0.5"
  }
}

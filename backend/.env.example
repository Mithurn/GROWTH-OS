PORT=3001
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
OPENROUTER_API_KEY=sk-or-v1-...
CHANNEL_SERVICE_URL=https://xeno-channel-service.onrender.com
# Must match the channel service's WEBHOOK_SECRET exactly.
# Generate with: openssl rand -base64 32
WEBHOOK_SECRET=
# Guards /api/internal/*, which an external cron calls to run the agent loop.
# Generate with: openssl rand -base64 32
INTERNAL_API_SECRET=
FRONTEND_URL=https://your-app.vercel.app
LOG_LEVEL=info
NODE_ENV=production
# Required — the server refuses to boot without a reachable Redis (queues, live
# updates, caching, frequency cap, webhook dedup all depend on it).
REDIS_URL=redis://...

# Local development only. Runs the agent loop on an in-process interval instead of
# waiting for the cron to call /api/internal/agents/run-scheduled.
ENABLE_AGENT_INTERVAL=false
AGENT_INTERVAL_MS=21600000
# Shadow observer. Omit to use OpenRouter when OPENROUTER_API_KEY is set.
# `scripted` runs the deterministic observe tape (no LLM, real Prisma tools).
# SHADOW_PLANNER=scripted
# SHADOW_AGENT=1

# Mutating tools stay off unless BOTH are set. Orchestrator never sets live.
# AGENT_LIVE=1
# Per-tenant: store { "live": true } on the agent's guardrails JSON.

# AES-256-GCM master key for BYOK secrets (32 bytes as 64 hex chars).
# Generate with: openssl rand -hex 32
# INTEGRATION_MASTER_KEY=

# Unset = meter but do not block the platform OpenRouter key.
# Explicit 0 = refuse platform spend and ask for BYOK.
# PLATFORM_MONTHLY_CAP_USD=

# Razorpay billing (test mode keys from dashboard.razorpay.com — no business
# verification needed for test mode). Unset disables billing entirely; the
# Upgrade button hides itself and BYOK still works on any plan.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_PLAN_ID=
# RAZORPAY_WEBHOOK_SECRET=

# GrowthOS's own send keys, used only for a Pro-plan tenant with no BYOK key
# of their own. Never required — BYOK and the simulator work without these.
# PLATFORM_RESEND_API_KEY=
# PLATFORM_RESEND_FROM_EMAIL=
# PLATFORM_TWILIO_ACCOUNT_SID=
# PLATFORM_TWILIO_AUTH_TOKEN=
# PLATFORM_TWILIO_WHATSAPP_NUMBER=

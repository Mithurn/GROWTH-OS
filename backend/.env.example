PORT=3001
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
OPENROUTER_API_KEY=sk-or-v1-...
CHANNEL_SERVICE_URL=https://xeno-channel-service.onrender.com
# Must match the channel service's WEBHOOK_SECRET exactly.
# Generate with: openssl rand -base64 32
WEBHOOK_SECRET=
# Guards /api/internal/*, which an external cron calls to run the agent loop.
# Generate with: openssl rand -base64 32
INTERNAL_API_SECRET=
FRONTEND_URL=https://your-app.vercel.app
LOG_LEVEL=info
NODE_ENV=production
# Optional — without it BullMQ workers are disabled and queued work runs inline
# inside the HTTP request instead.
REDIS_URL=redis://...

# Local development only. Runs the agent loop on an in-process interval instead of
# waiting for the cron to call /api/internal/agents/run-scheduled.
ENABLE_AGENT_INTERVAL=false
AGENT_INTERVAL_MS=21600000

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// PHASE 1: Core Tables
// ============================================

model Profile {
  id        String   @id // = Supabase auth.uid()
  companyId String   @map("company_id")
  role      String   @default("owner") // 'owner' | 'member'
  createdAt DateTime @default(now()) @map("created_at")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("profiles")
}

model Customer {
  id                   String   @id @default(uuid())
  companyId            String   @map("company_id")
  externalCustomerId   String?  @map("external_customer_id")
  firstName            String   @map("first_name")
  lastName             String?  @map("last_name")
  email                String?
  phone                String?
  gender               String?
  city                 String?
  state                String?
  signupDate           DateTime @default(now()) @map("signup_date")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders               Order[]
  customerMetrics      CustomerMetrics?
  customerAttributes   CustomerAttributes?
  persona              Persona?
  opportunities        OpportunityCustomer[]
  communications       Communication[]

  @@unique([companyId, externalCustomerId])
  @@index([companyId])
  @@index([email])
  @@index([phone])
  @@map("customers")
}

model Company {
  id           String   @id @default(uuid())
  userId       String?  @unique @map("user_id") // Supabase auth UID of owner
  companyName  String   @unique @map("company_name")
  industry     String?
  onboardingProfile Json? @map("onboarding_profile")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Billing — "free" is the demo/simulator tier, always available with no
  // real sends. "pro" unlocks real WhatsApp/Email sends on the platform's
  // own provider keys, funded by the subscription rather than the founder's
  // pocket. A tenant with their own verified BYOK integration can send for
  // real regardless of plan — billing gates the platform-funded path only.
  plan             String    @default("free") @map("plan")
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  subscriptionStatus   String?   @map("subscription_status")
  planUpdatedAt        DateTime? @map("plan_updated_at")
  // Stripe event `created` timestamp, not our own write time — see the
  // 20260918020000 migration for why out-of-order dedup needs this instead.
  lastStripeEventAt    DateTime? @map("last_stripe_event_at")

  // Formatting only — no monetary math depends on these. Was a hardcoded ₹/en-IN
  // in queues.ts and campaign-embeddings.ts; see docs/V3_PLAN.md Phase 1.3.
  currency     String   @default("INR")
  locale       String   @default("en-IN")

  profiles     Profile[]
  customers    Customer[]
  products     Product[]
  personas     Persona[]
  opportunities Opportunity[]
  campaigns    Campaign[]
  campaignApprovals CampaignApproval[]
  agents       Agent[]
  agentRuns    AgentRun[]
  ingestionSessions IngestionSession[]
  integrations Integration[]
  costLedger   CostLedger[]
  configOverrides CompanyConfig[]
  orders       Order[]
  orderItems   OrderItem[]
  customerMetrics CustomerMetrics[]
  customerAttributes CustomerAttributes[]

  @@index([companyName])
  @@map("companies")
}

model Product {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  sku          String   @map("sku")
  productName  String   @map("product_name")
  category     String?
  subcategory  String?  @map("subcategory")
  price        Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@map("products")
}

model IngestionSession {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  status       String   @default("pending") // pending | processing | complete | error
  step         String?
  progress     Int      @default(0)
  errorMessage String?  @map("error_message")
  // CSV payloads live here until the job finishes so a Render spin-down mid-run
  // can resume from the same session instead of leaving it stuck forever.
  customerCsv  Bytes?   @map("customer_csv")
  orderCsv     Bytes?   @map("order_csv")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("ingestion_sessions")
}

model Order {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  externalOrderId String?  @map("external_order_id")
  customerId      String   @map("customer_id")
  orderDate       DateTime @map("order_date")
  totalAmount     Decimal  @map("total_amount") @db.Decimal(10, 2)
  channel         String?
  createdAt       DateTime @default(now()) @map("created_at")

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([customerId])
  @@index([orderDate])
  @@index([companyId])
  @@index([companyId, orderDate])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid())
  companyId  String  @map("company_id")
  orderId    String  @map("order_id")
  productId  String  @map("product_id")
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([companyId])
  @@map("order_items")
}

model CustomerMetrics {
  id                  String   @id @default(uuid())
  companyId           String   @map("company_id")
  customerId          String   @unique @map("customer_id")
  totalOrders         Int      @default(0) @map("total_orders")
  totalSpent          Decimal  @default(0) @map("total_spent") @db.Decimal(10, 2)
  avgOrderValue       Decimal  @default(0) @map("avg_order_value") @db.Decimal(10, 2)
  lastOrderDate       DateTime? @map("last_order_date")
  daysSinceLastOrder  Int?     @map("days_since_last_order")
  purchaseFrequency   String?  @map("purchase_frequency")
  engagementScore     Decimal? @map("engagement_score") @db.Decimal(5, 2)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([totalSpent])
  @@index([lastOrderDate])
  @@index([companyId])
  @@index([companyId, totalSpent])
  @@map("customer_metrics")
}

model CustomerAttributes {
  id                      String   @id @default(uuid())
  companyId               String   @map("company_id")
  customerId              String   @unique @map("customer_id")
  favoriteCategory        String?  @map("favorite_category")
  secondFavoriteCategory  String?  @map("second_favorite_category")
  preferredChannel        String?  @map("preferred_channel")
  discountAffinity        String?  @map("discount_affinity")
  avgDaysBetweenOrders    Decimal? @map("avg_days_between_orders") @db.Decimal(10, 2)
  dominantPriceBand       String?  @map("dominant_price_band")
  categoryDiversityScore  Decimal  @default(0) @map("category_diversity_score") @db.Decimal(5, 2)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  company                 Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer                Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([favoriteCategory])
  @@index([preferredChannel])
  @@index([discountAffinity])
  @@index([dominantPriceBand])
  @@index([companyId])
  @@map("customer_attributes")
}

model Persona {
  id                 String   @id @default(uuid())
  companyId          String   @map("company_id")
  customerId         String   @unique @map("customer_id")
  personaName        String   @map("persona_name")
  personaDescription String   @map("persona_description")
  confidenceScore    Decimal  @default(0) @map("confidence_score") @db.Decimal(5, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([personaName])
  @@map("personas")
}

model Opportunity {
  id                        String   @id @default(uuid())
  companyId                 String   @map("company_id")
  agentId                   String?  @map("agent_id") // AI agent that discovered this
  opportunityKey            String   @map("opportunity_key")
  opportunityType           String   @map("opportunity_type")
  title                     String
  description               String
  audienceSize              Int      @default(0) @map("audience_size")
  potentialRevenue          Decimal  @default(0) @map("potential_revenue") @db.Decimal(12, 2)
  // Interval bounds around potentialRevenue from the same deterministic estimator
  // (packages/domain/src/impact/estimate.ts) — a single point number implies false
  // precision the UI should not repeat. Default equals potentialRevenue's default (0)
  // so existing rows read as a zero-width interval rather than null.
  potentialRevenueLow       Decimal  @default(0) @map("potential_revenue_low") @db.Decimal(12, 2)
  potentialRevenueHigh      Decimal  @default(0) @map("potential_revenue_high") @db.Decimal(12, 2)
  confidenceScore           Decimal  @default(0) @map("confidence_score") @db.Decimal(5, 2)
  priorityScore             Decimal  @default(0) @map("priority_score") @db.Decimal(5, 2)
  supportingCustomerSegment String   @map("supporting_customer_segment")
  recommendedAction         String   @map("recommended_action")
  audienceDefinition        Json     @map("audience_definition")
  triggerReason             String   @map("trigger_reason")
  aiSummary                 String   @map("ai_summary")
  aiReasoning               String?  @map("ai_reasoning") // Why AI discovered this
  predictedConversionRate   Float?   @map("predicted_conversion_rate")
  alternativeStrategies     Json?    @map("alternative_strategies")
  opportunityPersonas       Json?    @map("opportunity_personas")
  status                    String   @default("Detected")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  company                   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent                     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  audience                  OpportunityCustomer[]
  campaigns                 Campaign[]

  @@unique([companyId, opportunityKey])
  @@index([companyId])
  @@index([agentId])
  @@index([opportunityType])
  @@index([status])
  @@index([priorityScore])
  @@map("opportunities")
}

model OpportunityCustomer {
  id             String   @id @default(uuid())
  opportunityId  String   @map("opportunity_id")
  customerId     String   @map("customer_id")
  createdAt      DateTime @default(now()) @map("created_at")

  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  customer       Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, customerId])
  @@index([opportunityId])
  @@index([customerId])
  @@map("opportunity_customers")
}

// ============================================
// PHASE 2: Campaign Planner Tables
// ============================================

model Campaign {
  id               String    @id @default(uuid())
  companyId        String    @map("company_id")
  agentId          String?   @map("agent_id") // AI agent that launched this
  opportunityId    String    @map("opportunity_id")
  name             String
  objective        String
  channel          String
  offer            String?
  messageAngle     String?   @map("message_angle")
  messageContent   String    @map("message_content")
  messageVariants  Json?     @map("message_variants") // Different message versions for personalization
  expectedOutcome  String?   @map("expected_outcome")
  reasoning        String?
  status           String    @default("Draft")
  performance      Json?     // {sent: 1248, delivered: 1200, clicked: 450, converted: 89, revenue: 45200}
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  approvedAt       DateTime? @map("approved_at")
  launchedAt       DateTime? @map("launched_at")
  completedAt      DateTime? @map("completed_at")

  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent            Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  communications   Communication[]
  approvals        CampaignApproval[]

  @@index([companyId])
  @@index([agentId])
  @@index([opportunityId])
  @@index([status])
  @@index([createdAt])
  @@map("campaigns")
}

model CampaignApproval {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
  campaignId     String   @unique @map("campaign_id")
  actorId        String   @map("actor_id")
  decision       String
  reason         String?
  policyVersion  Int      @default(1) @map("policy_version")
  policySnapshot Json     @map("policy_snapshot")
  createdAt      DateTime @default(now()) @map("created_at")

  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([actorId])
  @@index([createdAt])
  @@map("campaign_approvals")
}

model Communication {
  id                  String    @id @default(uuid())
  campaignId          String    @map("campaign_id")
  customerId          String    @map("customer_id")
  channel             String
  message             String    // Personalized message for this customer
  messageVariant      String?   @map("message_variant") // Which variant was used (A, B, C)
  status              String    @default("QUEUED")
  providerMessageId   String?   @map("provider_message_id")
  failureReason       String?   @map("failure_reason")
  retryCount          Int       @default(0) @map("retry_count")
  converted           Boolean   @default(false) // Did customer make a purchase?
  revenue             Decimal?  @db.Decimal(10, 2) // Revenue from conversion
  sentAt              DateTime? @map("sent_at")
  deliveredAt         DateTime? @map("delivered_at")
  readAt              DateTime? @map("read_at")
  clickedAt           DateTime? @map("clicked_at")
  convertedAt         DateTime? @map("converted_at")
  failedAt            DateTime? @map("failed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  campaign            Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  events              CommunicationEvent[]

  @@index([campaignId])
  @@index([customerId])
  @@index([status])
  @@index([converted])
  @@index([providerMessageId])
  @@index([createdAt])
  @@map("communications")
}

model CommunicationEvent {
  id                String    @id @default(uuid())
  communicationId   String    @map("communication_id")
  eventType         String    @map("event_type")
  eventTimestamp    DateTime  @default(now()) @map("event_timestamp")
  sequenceNumber    Int       @map("sequence_number")
  providerMessageId String?   @map("provider_message_id")
  providerEventId   String?   @map("provider_event_id")
  errorMessage      String?   @map("error_message")
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")

  communication     Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
  @@index([eventType])
  @@index([eventTimestamp])
  @@index([sequenceNumber])
  @@index([providerEventId])
  @@map("communication_events")
}

model ProcessedWebhookEvent {
  id              String    @id @default(uuid())
  eventId         String    @unique @map("event_id")
  communicationId String?   @map("communication_id")
  processedAt     DateTime  @default(now()) @map("processed_at")

  @@index([eventId])
  @@index([processedAt])
  @@map("processed_webhook_events")
}

// ============================================
// AI-NATIVE SYSTEM: Autonomous Agents
// ============================================

enum InvolvementMode {
  manual
  approve_above_threshold
  autonomous_within_policy
}

model Agent {
  id              String    @id @default(uuid())
  companyId       String    @map("company_id")
  name            String    // Auto-generated: "Repeat Purchase Agent"
  goal            String    // User input: "Increase repeat purchases by 20%"
  status          String    @default("discovering") // 'discovering', 'running', 'paused', 'completed'
  involvementMode InvolvementMode @default(manual) @map("involvement_mode")
  guardrails      Json      // {max_budget: 50000, frequency_cap: 3, channels: ['whatsapp', 'email']}
  performance     Json?     // {revenue: 125000, conversion_rate: 0.38, customers_reached: 1248}
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  lastRunAt       DateTime? @map("last_run_at")

  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunities   Opportunity[]
  campaigns       Campaign[]
  actions         AgentAction[]
  runs            AgentRun[]

  @@index([companyId])
  @@index([status])
  @@index([createdAt])
  @@map("agents")
}

model AgentAction {
  id          String   @id @default(uuid())
  agentId     String   @map("agent_id")
  actionType  String   @map("action_type") // 'discovered_opportunity', 'launched_campaign', 'sent_messages', 'achieved_milestone'
  description String   // "Discovered VIP Recovery opportunity worth ₹45K"
  details     Json?    // Additional structured data
  createdAt   DateTime @default(now()) @map("created_at")

  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([actionType])
  @@index([createdAt])
  @@map("agent_actions")
}

// Phase 2: queryable run trace. Separate from LangGraph checkpoint tables.
// Checkpoint = how to resume. These rows = what happened (Run Trace / audit).
model AgentRun {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  agentId     String?   @map("agent_id")
  threadId    String    @unique @map("thread_id")
  goal        String
  status      String    @default("running") // running | finished | stopped
  summary     String    @default("")
  stepCount   Int       @default(0) @map("step_count")
  mode        String    @default("shadow")
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent       Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  steps       AgentStep[]

  @@index([companyId])
  @@index([agentId])
  @@index([startedAt])
  @@map("agent_runs")
}

model AgentStep {
  id          String   @id @default(uuid())
  runId       String   @map("run_id")
  companyId   String   @map("company_id")
  node        String
  toolName    String?  @map("tool_name")
  args        Json?
  result      Json?
  error       String?
  latencyMs   Int      @default(0) @map("latency_ms")
  createdAt   DateTime @default(now()) @map("created_at")

  run         AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([companyId])
  @@index([createdAt])
  @@map("agent_steps")
}

// Phase 5: BYOK credentials. Ciphertext is AES-256-GCM. Never select these
// columns into a log line or an API response — use services/integrations.ts.
model Integration {
  id             String    @id @default(uuid())
  companyId      String    @map("company_id")
  kind           String    // llm | email | whatsapp
  provider       String
  mode           String    @default("simulator") // simulator | byok | platform
  ciphertext     String?
  iv             String?
  authTag        String?   @map("auth_tag")
  keyVersion     Int       @default(1) @map("key_version")
  lastVerifiedAt DateTime? @map("last_verified_at")
  status         String    @default("unconfigured")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, kind])
  @@index([companyId])
  @@map("integrations")
}

model CostLedger {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  runId         String?  @map("run_id")
  provider      String
  model         String?
  tokensIn      Int      @default(0) @map("tokens_in")
  tokensOut     Int      @default(0) @map("tokens_out")
  estimatedCost Decimal  @default(0) @map("estimated_cost") @db.Decimal(12, 6)
  source        String   @default("platform") // platform | byok
  createdAt     DateTime @default(now()) @map("created_at")

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([runId])
  @@index([createdAt])
  @@map("cost_ledger")
}

// ============================================
// CONFIGURATION LAYER (docs/V3_PLAN.md Phase 1)
//
// Every tunable value formerly hardcoded in application code resolves through
// these three tables: company override -> plan override -> global default.
// See backend/src/lib/config.ts for resolution and packages/contracts/src/config
// for the Zod schema (and Zod-level default) each key must be registered under.
// ============================================

model ConfigDefault {
  key         String   @id
  value       Json
  description String
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("config_defaults")
}

/** planId matches Company.plan today ("free" | "pro") — becomes a real FK to a
    Plan table once Phase 3.1 (Stripe-synced plans) lands. */
model PlanConfig {
  id        String   @id @default(uuid())
  planId    String   @map("plan_id")
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([planId, key])
  @@index([planId])
  @@map("plan_config")
}

model CompanyConfig {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId])
  @@map("company_config")
}

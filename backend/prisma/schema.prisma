// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// PHASE 1: Core Tables
// ============================================

model Customer {
  id                   String   @id @default(uuid())
  externalCustomerId   String?  @map("external_customer_id")
  firstName            String   @map("first_name")
  lastName             String?  @map("last_name")
  email                String?  @unique
  phone                String?
  gender               String?
  city                 String?
  state                String?
  signupDate           DateTime @default(now()) @map("signup_date")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  orders               Order[]
  customerMetrics      CustomerMetrics?
  customerAttributes   CustomerAttributes?
  persona              Persona?
  opportunities        OpportunityCustomer[]
  communications       Communication[]

  @@index([email])
  @@index([phone])
  @@map("customers")
}

model Company {
  id           String   @id @default(uuid())
  companyName  String   @unique @map("company_name")
  industry     String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  personas     Persona[]
  opportunities Opportunity[]
  campaigns    Campaign[]

  @@index([companyName])
  @@map("companies")
}

model Product {
  id           String  @id @default(uuid())
  sku          String  @unique
  productName  String  @map("product_name")
  category     String?
  subcategory  String? @map("subcategory")
  price        Decimal @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  orderItems   OrderItem[]

  @@map("products")
}

model Order {
  id          String   @id @default(uuid())
  customerId  String   @map("customer_id")
  orderDate   DateTime @map("order_date")
  totalAmount Decimal  @map("total_amount") @db.Decimal(10, 2)
  channel     String?
  createdAt   DateTime @default(now()) @map("created_at")

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([customerId])
  @@index([orderDate])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String  @map("order_id")
  productId  String  @map("product_id")
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)

  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model CustomerMetrics {
  id                  String   @id @default(uuid())
  customerId          String   @unique @map("customer_id")
  totalOrders         Int      @default(0) @map("total_orders")
  totalSpent          Decimal  @default(0) @map("total_spent") @db.Decimal(10, 2)
  avgOrderValue       Decimal  @default(0) @map("avg_order_value") @db.Decimal(10, 2)
  lastOrderDate       DateTime? @map("last_order_date")
  daysSinceLastOrder  Int?     @map("days_since_last_order")
  purchaseFrequency   String?  @map("purchase_frequency")
  engagementScore     Decimal? @map("engagement_score") @db.Decimal(5, 2)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([totalSpent])
  @@index([lastOrderDate])
  @@map("customer_metrics")
}

model CustomerAttributes {
  id                      String   @id @default(uuid())
  customerId              String   @unique @map("customer_id")
  favoriteCategory        String?  @map("favorite_category")
  secondFavoriteCategory  String?  @map("second_favorite_category")
  preferredChannel        String?  @map("preferred_channel")
  discountAffinity        String?  @map("discount_affinity")
  avgDaysBetweenOrders    Decimal? @map("avg_days_between_orders") @db.Decimal(10, 2)
  dominantPriceBand       String?  @map("dominant_price_band")
  categoryDiversityScore  Decimal  @default(0) @map("category_diversity_score") @db.Decimal(5, 2)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  customer                Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([favoriteCategory])
  @@index([preferredChannel])
  @@index([discountAffinity])
  @@index([dominantPriceBand])
  @@map("customer_attributes")
}

model Persona {
  id                 String   @id @default(uuid())
  companyId          String   @map("company_id")
  customerId         String   @unique @map("customer_id")
  personaName        String   @map("persona_name")
  personaDescription String   @map("persona_description")
  confidenceScore    Decimal  @default(0) @map("confidence_score") @db.Decimal(5, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([personaName])
  @@map("personas")
}

model Opportunity {
  id                        String   @id @default(uuid())
  companyId                 String   @map("company_id")
  opportunityKey            String   @map("opportunity_key")
  opportunityType           String   @map("opportunity_type")
  title                     String
  description               String
  audienceSize              Int      @default(0) @map("audience_size")
  potentialRevenue          Decimal  @default(0) @map("potential_revenue") @db.Decimal(12, 2)
  confidenceScore           Decimal  @default(0) @map("confidence_score") @db.Decimal(5, 2)
  priorityScore             Decimal  @default(0) @map("priority_score") @db.Decimal(5, 2)
  supportingCustomerSegment String   @map("supporting_customer_segment")
  recommendedAction         String   @map("recommended_action")
  audienceDefinition        Json     @map("audience_definition")
  triggerReason             String   @map("trigger_reason")
  aiSummary                 String   @map("ai_summary")
  status                    String   @default("Detected")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  company                   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  audience                  OpportunityCustomer[]
  campaigns                 Campaign[]

  @@unique([companyId, opportunityKey])
  @@index([companyId])
  @@index([opportunityType])
  @@index([status])
  @@index([priorityScore])
  @@map("opportunities")
}

model OpportunityCustomer {
  id             String   @id @default(uuid())
  opportunityId  String   @map("opportunity_id")
  customerId     String   @map("customer_id")
  createdAt      DateTime @default(now()) @map("created_at")

  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  customer       Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, customerId])
  @@index([opportunityId])
  @@index([customerId])
  @@map("opportunity_customers")
}

// ============================================
// PHASE 2: Campaign Planner Tables
// ============================================

model Campaign {
  id               String    @id @default(uuid())
  companyId        String    @map("company_id")
  opportunityId    String    @map("opportunity_id")
  name             String
  objective        String
  channel          String
  offer            String?
  messageAngle     String?   @map("message_angle")
  messageContent   String    @map("message_content")
  expectedOutcome  String?   @map("expected_outcome")
  reasoning        String?
  status           String    @default("Draft")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  approvedAt       DateTime? @map("approved_at")
  launchedAt       DateTime? @map("launched_at")
  completedAt      DateTime? @map("completed_at")

  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  communications   Communication[]

  @@index([companyId])
  @@index([opportunityId])
  @@index([status])
  @@index([createdAt])
  @@map("campaigns")
}

model Communication {
  id                  String    @id @default(uuid())
  campaignId          String    @map("campaign_id")
  customerId          String    @map("customer_id")
  channel             String
  message             String
  status              String    @default("QUEUED")
  providerMessageId   String?   @map("provider_message_id")
  failureReason       String?   @map("failure_reason")
  retryCount          Int       @default(0) @map("retry_count")
  sentAt              DateTime? @map("sent_at")
  deliveredAt         DateTime? @map("delivered_at")
  readAt              DateTime? @map("read_at")
  clickedAt           DateTime? @map("clicked_at")
  failedAt            DateTime? @map("failed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  campaign            Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  events              CommunicationEvent[]

  @@index([campaignId])
  @@index([customerId])
  @@index([status])
  @@index([providerMessageId])
  @@index([createdAt])
  @@map("communications")
}

model CommunicationEvent {
  id                String    @id @default(uuid())
  communicationId   String    @map("communication_id")
  eventType         String    @map("event_type")
  eventTimestamp    DateTime  @default(now()) @map("event_timestamp")
  sequenceNumber    Int       @map("sequence_number")
  providerMessageId String?   @map("provider_message_id")
  providerEventId   String?   @map("provider_event_id")
  errorMessage      String?   @map("error_message")
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")

  communication     Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
  @@index([eventType])
  @@index([eventTimestamp])
  @@index([sequenceNumber])
  @@index([providerEventId])
  @@map("communication_events")
}

model ProcessedWebhookEvent {
  id              String    @id @default(uuid())
  eventId         String    @unique @map("event_id")
  communicationId String?   @map("communication_id")
  processedAt     DateTime  @default(now()) @map("processed_at")

  @@index([eventId])
  @@index([processedAt])
  @@map("processed_webhook_events")
}

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "paths": {
      "@growthos/domain": ["../packages/domain/src/index.ts"],
      "@growthos/domain/*": ["../packages/domain/src/*"],
      "@growthos/contracts": ["../packages/contracts/src/index.ts"],
      "@growthos/contracts/*": ["../packages/contracts/src/*"],
      "@growthos/agent-core": ["../packages/agent-core/src/index.ts"],
      "@growthos/agent-core/*": ["../packages/agent-core/src/*"],
      "@growthos/ingest": ["../packages/ingest/src/index.ts"],
      "@growthos/ingest/*": ["../packages/ingest/src/*"],
      "vitest": ["./node_modules/vitest"],
      "zod": ["./node_modules/zod"],
      "@langchain/langgraph": ["./node_modules/@langchain/langgraph"],
      "@langchain/langgraph-checkpoint": ["./node_modules/@langchain/langgraph-checkpoint"],
      "@langchain/langgraph-checkpoint-postgres": ["./node_modules/@langchain/langgraph-checkpoint-postgres"],
      "@langchain/core": ["./node_modules/@langchain/core"],
      "@opentelemetry/api": ["./node_modules/@opentelemetry/api"]
    }
  },
  "include": [
    "src/**/*",
    "../packages/domain/src/**/*",
    "../packages/contracts/src/**/*",
    "../packages/agent-core/src/**/*",
    "../packages/ingest/src/**/*",
    "../packages/evals/src/**/*"
  ],
  "exclude": ["node_modules"]
}

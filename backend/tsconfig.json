{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "paths": {
      "@growthos/domain": ["../packages/domain/src/index.ts"],
      "@growthos/domain/*": ["../packages/domain/src/*"],
      "vitest": ["./node_modules/vitest"]
    }
  },
  "include": ["src/**/*", "../packages/domain/src/**/*"],
  "exclude": ["node_modules"]
}
